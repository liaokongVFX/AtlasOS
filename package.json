{
  "name": "atlasos",
  "version": "0.0.11",
  "description": "Local-first infinite canvas workspace built with Electron and React.",
  "main": "out/main/index.js",
  "author": "AtlasOS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ensure:electron": "node scripts/ensure-electron.cjs",
    "dev": "npm run ensure:electron && cross-env NO_SANDBOX=1 electron-vite dev",
    "dev:sandbox": "npm run ensure:electron && electron-vite dev",
    "build": "npm run verify:assets && tsc --noEmit && electron-vite build",
    "test": "vitest run --passWithNoTests",
    "verify:no-tests": "node scripts/verify-no-committed-tests.cjs",
    "verify:assets": "node scripts/verify-build-assets.cjs && node scripts/verify-windows-update-artifact-name.cjs",
    "release:guard": "node scripts/verify-release-tag.cjs",
    "package:win": "npm run ensure:electron && cross-env npm_config_devdir=.electron-gyp npm run build && cross-env npm_config_devdir=.electron-gyp electron-builder --win nsis --publish never",
    "package:win:publish": "npm run ensure:electron && npm run release:guard && cross-env npm_config_devdir=.electron-gyp npm run build && cross-env npm_config_devdir=.electron-gyp electron-builder --win nsis --publish always",
    "package:mac": "npm run ensure:electron && cross-env npm_config_devdir=.electron-gyp npm run build && cross-env npm_config_devdir=.electron-gyp electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "package:mac:publish": "npm run ensure:electron && npm run release:guard && cross-env npm_config_devdir=.electron-gyp npm run build && cross-env npm_config_devdir=.electron-gyp electron-builder --mac dmg zip --x64 --arm64 --publish always",
    "rebuild": "cross-env npm_config_devdir=.electron-gyp electron-rebuild -f -w node-pty,sharp"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@hookform/resolvers": "^5.2.2",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-virtual": "^3.13.12",
    "@tiptap/extension-text-align": "^3.26.1",
    "@tiptap/extension-underline": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@types/ssh2": "^1.15.5",
    "@uiw/react-codemirror": "^4.25.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.3",
    "fast-glob": "^3.3.3",
    "immer": "^10.1.3",
    "lucide-react": "^0.553.0",
    "nanoid": "^5.1.6",
    "node-pty": "^1.0.0",
    "react": "^19.2.0",
    "react-arborist": "^3.4.3",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.4",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.3.1",
    "trash": "^10.0.0",
    "write-file-atomic": "^7.0.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "electron": "42.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "happy-dom": "^20.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "dev.atlasos.workbench",
    "productName": "AtlasOS",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "build/icon-16.png",
      "build/icon-32.png",
      "package.json"
    ],
    "npmRebuild": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "publish": [
        {
          "provider": "github",
          "releaseType": "release"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "publish": [
        {
          "provider": "github",
          "releaseType": "release"
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}.Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
